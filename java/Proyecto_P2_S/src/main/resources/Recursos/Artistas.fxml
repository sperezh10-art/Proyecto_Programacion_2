<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768" prefWidth="1366"
            styleClass="app"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.umg.api.controller.Artistas_Controller">

    <left>
        <VBox fx:id="tbMenuLateral" spacing="0">
            <padding>
                <Insets bottom="12" left="12" right="12" top="16"/>
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <padding>
                        <Insets bottom="0" left="6" right="6" top="0"/>
                    </padding>

                    <children>
                        <StackPane maxHeight="34" maxWidth="34"
                                   minHeight="34" minWidth="34"
                                   prefHeight="34" prefWidth="34"
                                   styleClass="logo">
                            <children>
                                <Region maxHeight="20" maxWidth="20"
                                        minHeight="20" minWidth="20"
                                        prefHeight="20" prefWidth="20"
                                        styleClass="icon,ic-ticket,ic-dark"/>
                            </children>
                        </StackPane>

                        <VBox spacing="3">
                            <children>
                                <Label styleClass="disp,s21" text="SVB·GUA"/>
                                <Label styleClass="s10,w600,c-dim"
                                       text="TAQUILLA V1.0"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="2">
                    <children>
                        <Label styleClass="eyebrow" text="OPERACIÓN">
                            <padding>
                                <Insets bottom="6" left="10" right="10" top="0"/>
                            </padding>
                        </Label>

                        <Button alignment="CENTER_LEFT"
                                graphicTextGap="10"
                                maxWidth="Infinity"
                                mnemonicParsing="false"
                                prefHeight="38"
                                styleClass="nav-item"
                                text="Panel de control">
                            <graphic>
                                <Region maxHeight="20" maxWidth="20"
                                        minHeight="20" minWidth="20"
                                        prefHeight="20" prefWidth="20"
                                        styleClass="icon,ic-dashboard,ic-text2"/>
                            </graphic>
                        </Button>

                        <Button alignment="CENTER_LEFT"
                                graphicTextGap="10"
                                maxWidth="Infinity"
                                mnemonicParsing="false"
                                prefHeight="38"
                                styleClass="nav-item"
                                text="Punto de venta">
                            <graphic>
                                <Region maxHeight="20" maxWidth="20"
                                        minHeight="20" minWidth="20"
                                        prefHeight="20" prefWidth="20"
                                        styleClass="icon,ic-pos,ic-text2"/>
                            </graphic>
                        </Button>

                        <Button alignment="CENTER_LEFT"
                                graphicTextGap="10"
                                maxWidth="Infinity"
                                mnemonicParsing="false"
                                prefHeight="38"
                                styleClass="nav-item"
                                text="Historial de ventas">
                            <graphic>
                                <Region maxHeight="20" maxWidth="20"
                                        minHeight="20" minWidth="20"
                                        prefHeight="20" prefWidth="20"
                                        styleClass="icon,ic-list,ic-text2"/>
                            </graphic>
                        </Button>

                        <Button alignment="CENTER_LEFT"
                                graphicTextGap="10"
                                maxWidth="Infinity"
                                mnemonicParsing="false"
                                prefHeight="38"
                                styleClass="nav-item"
                                text="Reportes">
                            <graphic>
                                <Region maxHeight="20" maxWidth="20"
                                        minHeight="20" minWidth="20"
                                        prefHeight="20" prefWidth="20"
                                        styleClass="icon,ic-chart,ic-text2"/>
                            </graphic>
                        </Button>
                    </children>
                </VBox>

                <VBox spacing="2">
                    <children>
                        <Label styleClass="eyebrow" text="CATÁLOGOS">
                            <padding>
                                <Insets bottom="6" left="10" right="10" top="0"/>
                            </padding>
                        </Label>

                        <!-- ARTISTAS -->
                        <Button fx:id="btnArtistas"
                                alignment="CENTER_LEFT"
                                graphicTextGap="10"
                                maxWidth="Infinity"
                                mnemonicParsing="false"
                                prefHeight="38"
                                styleClass="nav-item,nav-active"
                                text="Artistas">
                            <graphic>
                                <Region maxHeight="20" maxWidth="20"
                                        minHeight="20" minWidth="20"
                                        prefHeight="20" prefWidth="20"
                                        styleClass="icon,ic-mic,ic-amber"/>
                            </graphic>
                        </Button>

                        <!-- CONCIERTOS -->
                        <Button fx:id="btnConciertos"
                                alignment="CENTER_LEFT"
                                graphicTextGap="10"
                                maxWidth="Infinity"
                                mnemonicParsing="false"
                                prefHeight="38"
                                styleClass="nav-item"
                                text="Conciertos">
                            <graphic>
                                <Region maxHeight="20" maxWidth="20"
                                        minHeight="20" minWidth="20"
                                        prefHeight="20" prefWidth="20"
                                        styleClass="icon,ic-event,ic-text2"/>
                            </graphic>
                        </Button>

                        <!-- LOCALIDADES -->
                        <Button fx:id="btnLocalidades"
                                alignment="CENTER_LEFT"
                                graphicTextGap="10"
                                maxWidth="Infinity"
                                mnemonicParsing="false"
                                prefHeight="38"
                                styleClass="nav-item"
                                text="Localidades">
                            <graphic>
                                <Region maxHeight="20" maxWidth="20"
                                        minHeight="20" minWidth="20"
                                        prefHeight="20" prefWidth="20"
                                        styleClass="icon,ic-seat,ic-text2"/>
                            </graphic>
                        </Button>

                        <!-- USUARIOS -->
                        <Button fx:id="btnUsuarios"
                                alignment="CENTER_LEFT"
                                graphicTextGap="10"
                                maxWidth="Infinity"
                                mnemonicParsing="false"
                                prefHeight="38"
                                styleClass="nav-item"
                                text="Usuarios">
                            <graphic>
                                <Region maxHeight="20" maxWidth="20"
                                        minHeight="20" minWidth="20"
                                        prefHeight="20" prefWidth="20"
                                        styleClass="icon,ic-group,ic-text2"/>
                            </graphic>
                        </Button>
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="4" styleClass="turno-card">
                    <padding>
                        <Insets bottom="12" left="12" right="12" top="12"/>
                    </padding>
                    <children>
                        <Label styleClass="eyebrow" text="HOY · TODAS"/>
                        <Label styleClass="disp,s24" text="Q 48,350"/>
                        <Label styleClass="s12,c-muted"
                               text="16 ventas · 41 boletos"/>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <padding>
                        <Insets bottom="0" left="4" right="4" top="4"/>
                    </padding>
                    <children>
                        <StackPane maxHeight="34" maxWidth="34"
                                   minHeight="34" minWidth="34"
                                   prefHeight="34" prefWidth="34"
                                   styleClass="avatar">
                            <children>
                                <Label styleClass="s12,w700,c-amber"
                                       text="AM"/>
                            </children>
                        </StackPane>

                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="s13,w600"
                                       text="Andrea Morales"/>
                                <Label styleClass="s11,c-dim"
                                       text="Administrador"/>
                            </children>
                        </VBox>

                        <Button id="btnCerrarSesion"
                                graphicTextGap="8"
                                mnemonicParsing="false"
                                styleClass="btn-icon">
                            <graphic>
                                <Region maxHeight="18" maxWidth="18"
                                        minHeight="18" minWidth="18"
                                        prefHeight="18" prefWidth="18"
                                        styleClass="icon,ic-logout,ic-muted"/>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox>
            <children>
                <!-- ENCABEZADO -->
                <HBox alignment="BOTTOM_LEFT" spacing="10">
                    <padding>
                        <Insets bottom="16" left="28" right="28" top="22"/>
                    </padding>

                    <children>
                        <VBox spacing="6">
                            <children>
                                <Label fx:id="lblSeccion"
                                       styleClass="eyebrow"
                                       text="CATÁLOGO · ARTISTAS"/>

                                <Label fx:id="lblTitulo"
                                       styleClass="disp,s34"
                                       text="ARTISTAS"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER_LEFT"
                              prefHeight="40"
                              prefWidth="280"
                              spacing="10"
                              styleClass="field">
                            <children>
                                <Region maxHeight="19" maxWidth="19"
                                        minHeight="19" minWidth="19"
                                        prefHeight="19" prefWidth="19"
                                        styleClass="icon,ic-search"/>

                                <TextField fx:id="txtBuscar"
                                           promptText="Buscar artista, género o agencia"
                                           styleClass="field-input"
                                           HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>

                        <Button id="btnNuevoArtista"
                                fx:id="btnCrear_Artista"
                                graphicTextGap="8"
                                mnemonicParsing="false"
                                prefHeight="40"
                                styleClass="btn-primary"
                                text="Nuevo artista">
                            <graphic>
                                <Region maxHeight="18" maxWidth="18"
                                        minHeight="18" minWidth="18"
                                        prefHeight="18" prefWidth="18"
                                        styleClass="icon,ic-add,ic-dark"/>
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <!-- TABLA DINÁMICA -->
                <VBox styleClass="table" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets bottom="24" left="28" right="28"/>
                    </VBox.margin>

                    <children>
                        <GridPane fx:id="gridEncabezado"
                                  hgap="12"
                                  styleClass="thead">
                            <columnConstraints>
                                <ColumnConstraints maxWidth="50.0"
                                                   minWidth="50.0"
                                                   prefWidth="50.0"/>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   maxWidth="382.0"
                                                   minWidth="10.0"
                                                   prefWidth="357.6"/>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   maxWidth="422.8"
                                                   minWidth="10.0"
                                                   prefWidth="268.8"/>
                                <ColumnConstraints hgrow="ALWAYS"
                                                   maxWidth="413.2"
                                                   minWidth="10.0"
                                                   prefWidth="259.2"/>
                                <ColumnConstraints halignment="RIGHT"
                                                   maxWidth="72.0"
                                                   minWidth="72.0"
                                                   prefWidth="72.0"/>
                            </columnConstraints>

                            <padding>
                                <Insets bottom="11" left="18"
                                        right="18" top="11"/>
                            </padding>

                            <children>
                                <Label styleClass="th"
                                       text="ID"
                                       GridPane.columnIndex="0"/>

                                <Label styleClass="th"
                                       text="NOMBRE ARTÍSTICO"
                                       GridPane.columnIndex="1"/>

                                <Label styleClass="th"
                                       text="GÉNERO MUSICAL"
                                       GridPane.columnIndex="2"/>

                                <Label styleClass="th"
                                       text="AGENCIA"
                                       GridPane.columnIndex="3"/>

                                <Label styleClass="th"
                                       GridPane.columnIndex="4"/>
                            </children>

                            <rowConstraints>
                                <RowConstraints/>
                            </rowConstraints>
                        </GridPane>

                        <ScrollPane fitToWidth="true"
                                    styleClass="scroll"
                                    VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="contenedorFilas"
                                      spacing="0"/>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>