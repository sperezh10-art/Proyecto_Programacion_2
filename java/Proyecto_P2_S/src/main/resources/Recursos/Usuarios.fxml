<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1366.0" prefHeight="768.0"
            styleClass="app"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.umg.api.controller.Usuarios_Controller">

    <!-- PANEL LATERAL -->
    <left>
        <VBox prefWidth="245.0" spacing="24.0" styleClass="sidebar">
            <padding>
                <Insets top="28.0" right="18.0" bottom="24.0" left="18.0"/>
            </padding>

            <VBox spacing="5.0">
                <Label text="CONCERT" styleClass="brand"/>
                <Label text="SISTEMA DE GESTIÓN" styleClass="brand-subtitle"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="MENÚ PRINCIPAL" styleClass="sidebar-section"/>

                <Button text="  Inicio"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  Artistas"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  Conciertos"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  Estadios"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  Usuarios"
                        maxWidth="Infinity"
                        styleClass="nav-button-active"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="5.0" styleClass="sidebar-footer">
                <Label text="PANEL ADMINISTRATIVO" styleClass="sidebar-section"/>
                <Label text="Gestión de conciertos y usuarios"
                       styleClass="muted"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENIDO PRINCIPAL -->
    <center>
        <VBox spacing="22.0" styleClass="main-content">
            <padding>
                <Insets top="30.0" right="32.0" bottom="28.0" left="32.0"/>
            </padding>

            <!-- ENCABEZADO -->
            <HBox alignment="CENTER_LEFT" spacing="18.0">
                <VBox spacing="7.0">
                    <Label fx:id="lblResumen"
                           text="CARGANDO USUARIOS..."
                           styleClass="eyebrow"/>

                    <Label text="USUARIOS"
                           styleClass="disp,s34"/>

                    <Label text="Administra las cuentas y sus permisos de acceso."
                           styleClass="muted"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnNuevoUsuario"
                        text="＋  Nuevo usuario"
                        styleClass="btn-primary"
                        onAction="#abrirFormulario"/>
            </HBox>

            <!-- TABLA -->
            <VBox spacing="0.0" VBox.vgrow="ALWAYS" styleClass="table-card">

                <!-- ENCABEZADOS DE COLUMNAS -->
                <GridPane styleClass="table-header">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="22.0" minWidth="150.0"/>
                        <ColumnConstraints percentWidth="15.0" minWidth="105.0"/>
                        <ColumnConstraints percentWidth="15.0" minWidth="100.0"/>
                        <ColumnConstraints percentWidth="13.0" minWidth="95.0"/>
                        <ColumnConstraints percentWidth="13.0" minWidth="95.0"/>
                        <ColumnConstraints percentWidth="12.0" minWidth="90.0"/>
                        <ColumnConstraints percentWidth="10.0" minWidth="85.0"/>
                    </columnConstraints>

                    <Label text="USUARIO" GridPane.columnIndex="0"/>
                    <Label text="ROL" GridPane.columnIndex="1"/>
                    <Label text="PUNTO DE VENTA" GridPane.columnIndex="2"/>
                    <Label text="CREADO" GridPane.columnIndex="3"/>
                    <Label text="ÚLTIMO ACCESO" GridPane.columnIndex="4"/>
                    <Label text="ESTADO" GridPane.columnIndex="5"/>
                    <Label text="ACCIONES" GridPane.columnIndex="6"/>
                </GridPane>

                <!-- LAS FILAS SE CREAN DESDE Usuarios_Controller.java -->
                <ScrollPane fx:id="scrollUsuarios"
                            fitToWidth="true"
                            hbarPolicy="AS_NEEDED"
                            vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS"
                            styleClass="scroll">

                    <content>
                        <VBox fx:id="contenedorUsuarios"
                              spacing="0.0"/>
                    </content>
                </ScrollPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
