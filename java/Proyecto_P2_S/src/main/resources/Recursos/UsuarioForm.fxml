<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="500" styleClass="dialog" spacing="16" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@styles.css">
  <fx:define>
    <ToggleGroup fx:id="grupoRol"/>
  </fx:define>
  <padding><Insets top="22" right="24" bottom="22" left="24"/></padding>
  <children>
    <HBox alignment="CENTER_LEFT">
      <children>
        <Label text="NUEVO USUARIO" styleClass="disp,s26"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="btn-icon" mnemonicParsing="false" graphicTextGap="8" cancelButton="true">
          <graphic>
            <Region styleClass="icon,ic-close,ic-muted" minWidth="18" minHeight="18" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
          </graphic>
        </Button>
      </children>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="12">
      <children>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
          <children>
            <Label text="Usuario" styleClass="form-lbl"/>
            <TextField promptText="p. ej. mcastillo" styleClass="input" prefHeight="42" id="txtUsuario"/>
          </children>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
          <children>
            <Label text="Nombre completo" styleClass="form-lbl"/>
            <TextField styleClass="input" prefHeight="42" id="txtNombre"/>
          </children>
        </VBox>
      </children>
    </HBox>
    <VBox spacing="6">
      <children>
        <Label text="Rol" styleClass="form-lbl"/>
        <HBox alignment="CENTER_LEFT" spacing="10">
          <children>
            <ToggleButton text="Vendedor" toggleGroup="$grupoRol" selected="true" styleClass="tile-sm" mnemonicParsing="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="44">
              <graphic>
                <Region styleClass="icon,ic-pos,ic-amber" minWidth="19" minHeight="19" prefWidth="19" prefHeight="19" maxWidth="19" maxHeight="19"/>
              </graphic>
            </ToggleButton>
            <ToggleButton text="Administrador" toggleGroup="$grupoRol" styleClass="tile-sm" mnemonicParsing="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" graphicTextGap="10" prefHeight="44">
              <graphic>
                <Region styleClass="icon,ic-shield,ic-muted" minWidth="19" minHeight="19" prefWidth="19" prefHeight="19" maxWidth="19" maxHeight="19"/>
              </graphic>
            </ToggleButton>
          </children>
        </HBox>
      </children>
    </VBox>
    <HBox alignment="CENTER_LEFT" spacing="12">
      <children>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
          <children>
            <Label text="Contraseña" styleClass="form-lbl"/>
            <PasswordField id="txtContrasena" promptText="Mín. 8 caracteres" styleClass="input" prefHeight="42"/>
          </children>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
          <children>
            <Label text="Confirmar contraseña" styleClass="form-lbl"/>
            <PasswordField id="txtConfirmar" styleClass="input" prefHeight="42"/>
          </children>
        </VBox>
      </children>
    </HBox>
    <HBox alignment="CENTER_LEFT" id="lblError" spacing="8" visible="false" managed="false">
      <children>
        <Region styleClass="icon,ic-error,ic-red" minWidth="18" minHeight="18" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18"/>
        <Label text="Las contraseñas no coinciden." styleClass="s13,c-red"/>
      </children>
    </HBox>
    <HBox alignment="CENTER_RIGHT" spacing="10">
      <children>
        <Button text="Cancelar" styleClass="btn-ghost" mnemonicParsing="false" graphicTextGap="8" prefHeight="42"/>
        <Button text="Guardar" styleClass="btn-primary" mnemonicParsing="false" graphicTextGap="8" id="btnGuardar" prefHeight="42" defaultButton="true"/>
      </children>
    </HBox>
  </children>
</VBox>
